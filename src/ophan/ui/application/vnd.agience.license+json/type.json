{
  "content_type": "application/vnd.agience.license+json",
  "version": 1,
  "inherits": [
    "application/json"
  ],
  "description": "A projected license record managed by Ophan. Captures operational state for an issued license without making the artifact itself the trust artifact.",
  "context_schema": {
    "license_id": "string — license identifier",
    "entitlement_id": "string — parent entitlement identifier",
    "account_id": "string — licensed operator or account",
    "policy_id": "string — commercial policy identifier",
    "control_class": "string? — licensing control class",
    "product_surface": "string? — target product surface",
    "runtime_roles": "string[] — allowed runtime roles",
    "distribution_profiles": "string[] — allowed packaging profiles",
    "branding_scope": "string[] — allowed branding surfaces",
    "entitlements": "string[] — resolved entitlements in effect",
    "state": "string — active | grace | revoked | expired",
    "issued_at": "string — ISO 8601 timestamp",
    "not_before": "string — ISO 8601 timestamp",
    "expires_at": "string — ISO 8601 timestamp",
    "artifact_status": "string? — issued | pending | superseded",
    "artifact_ref": "string? — opaque reference to artifact storage",
    "limits": "object? — current commercial limits",
    "features": "object? — enabled commercial features"
  },
  "ui": {
    "label": "License",
    "icon": "shield-check",
    "color": "#059669",
    "badge_class": "bg-emerald-100 text-emerald-800",
    "tile_class": "ring-1 ring-emerald-200/70",
    "modes": [
      "floating",
      "preview"
    ],
    "states": [
      "view"
    ],
    "default_mode": "floating",
    "default_state": "view",
    "is_container": false,
    "creatable": false,
    "description": "Operational license projection owned by Ophan.",
    "resource_uri": "ui://ophan/vnd.agience.license.html",
    "resource_server": "ophan"
  }
}
