# Copy to bff/.env on the server and fill in. ALL values are optional:
# with none set, leads are still captured durably to the bff-data volume
# (/data/leads.jsonl) and chat returns a friendly fallback message.

# ── Email notifications for new leads ──────────────────────────────────────
# Gmail: create an App Password (https://myaccount.google.com/apppasswords),
# then use it as SMTP_PASS. host/port below are correct for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@agience.ai
# SMTP_PASS=your-16-char-app-password
# LEAD_TO=connect@agience.ai
# LEAD_FROM=you@agience.ai

# ── Instant notification webhook (Slack / Discord / Zapier incoming webhook) ─
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Chat assistant (Anthropic) ─────────────────────────────────────────────
# Without a key, the chat widget returns a canned "we'll follow up" reply.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# CHAT_SYSTEM_PROMPT=You are the friendly assistant on agience.ai ...
