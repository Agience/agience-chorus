{
  "content_type": "application/vnd.agience.backlog-item+json",
  "version": 1,
  "inherits": [
    "application/json"
  ],
  "description": "Backlog item — one piece of work, carried from open to closed: open, working, in cut (taken into a release), validated, shipped, closed (done, out of the open Backlog; closed_in names the release).",
  "view": {
    "apart": {
      "closed": {
        "label": "Closed",
        "when": {
          "field": "context.state",
          "equals": "closed"
        }
      }
    }
  },
  "ui": {
    "label": "Backlog item",
    "icon": "list-checks",
    "color": "#b45309",
    "badge_class": "bg-amber-100 text-amber-800",
    "tile_class": "",
    "modes": [
      "floating",
      "preview"
    ],
    "states": [
      "view",
      "edit"
    ],
    "default_mode": "floating",
    "default_state": "view",
    "is_container": false,
    "creatable": true,
    "resource_uri": "ui://astra/vnd.agience.record.html",
    "resource_server": "astra",
    "record": {
      "titlePath": "title",
      "fields": [
        {
          "path": "key",
          "label": "Key",
          "editable": false
        },
        {
          "path": "state",
          "label": "State",
          "editable": true,
          "editor": "select",
          "options": [
            "open",
            "working",
            "in_cut",
            "validated",
            "shipped",
            "closed"
          ]
        },
        {
          "path": "priority",
          "label": "Priority",
          "editable": true,
          "editor": "select",
          "options": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        {
          "path": "size",
          "label": "Size",
          "editable": true,
          "editor": "select",
          "options": [
            "S",
            "M",
            "L"
          ]
        },
        {
          "path": "closed_in",
          "label": "Closed in",
          "editable": true
        },
        {
          "path": "release",
          "label": "Shipped in",
          "editable": true
        },
        {
          "path": "raised_by",
          "label": "Raised by",
          "editable": true
        }
      ]
    }
  },
  "context_schema": {
    "title": {
      "type": "string",
      "mutable": true
    },
    "number": {
      "type": "integer",
      "description": "Its number, taken from the collection's number provider when it is created. Does not change.",
      "mutable": false
    },
    "key": {
      "type": "string",
      "description": "Its key: the provider's prefix and its number, as in PREFIX-114. Does not change.",
      "mutable": false
    },
    "state": {
      "type": "enum",
      "values": [
        "open",
        "working",
        "in_cut",
        "validated",
        "shipped",
        "closed"
      ],
      "description": "Where the item is in the loop: open → working → in_cut → validated → shipped → closed.",
      "mutable": true
    },
    "priority": {
      "type": "enum",
      "values": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "description": "How urgent: P0 (now) to P4.",
      "mutable": true
    },
    "size": {
      "type": "enum",
      "values": [
        "S",
        "M",
        "L"
      ],
      "description": "Rough size.",
      "mutable": true
    },
    "raised_by": {
      "type": "string",
      "description": "Who raised it (a person or a session).",
      "mutable": true
    },
    "commits": {
      "type": "object",
      "description": "The commits that carry it, by repository, once it is worked.",
      "mutable": true
    },
    "release": {
      "type": "string",
      "description": "The release that shipped it, once shipped.",
      "mutable": true
    },
    "closed_in": {
      "type": "string",
      "description": "The release it was closed in: set when the release that shipped it is recorded, or by hand for work verified earlier.",
      "mutable": true
    }
  },
  "fields": {
    "number": {
      "on_create": {
        "from_edge": "numbered_by",
        "key": "key"
      }
    }
  }
}
