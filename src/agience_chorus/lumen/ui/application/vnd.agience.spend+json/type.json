{
  "content_type": "application/vnd.agience.spend+json",
  "version": 1,
  "inherits": [
    "application/json"
  ],
  "description": "Spend — one charge against a budget. Created in a collection edged by charged_to to a budget, it adds its amount to the budget's spent and records which budget it was charged to; past the budget's limit it is refused. Its amount and budget cannot change after it is made.",
  "ui": {
    "label": "Spend",
    "icon": "receipt",
    "color": "#b45309",
    "badge_class": "bg-amber-100 text-amber-800",
    "tile_class": "",
    "modes": [
      "floating",
      "preview"
    ],
    "states": [
      "view",
      "edit"
    ],
    "default_mode": "floating",
    "default_state": "view",
    "is_container": false,
    "creatable": true,
    "resource_uri": "ui://astra/vnd.agience.record.html",
    "resource_server": "astra",
    "record": {
      "titlePath": "title",
      "fields": [
        {
          "path": "amount",
          "label": "Amount",
          "editable": false
        },
        {
          "path": "budget",
          "label": "Budget",
          "editable": false
        }
      ]
    }
  },
  "context_schema": {
    "title": {
      "type": "string",
      "mutable": true
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "What this spend costs, in the budget's unit.",
      "mutable": false
    },
    "budget": {
      "type": "string",
      "description": "The budget it was charged to; set on create.",
      "mutable": false
    }
  },
  "fields": {
    "budget": {
      "on_create": {
        "from_edge": "charged_to",
        "amount": "amount",
        "to": "spent",
        "limit": "limit"
      }
    }
  }
}
